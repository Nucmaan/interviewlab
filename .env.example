# IRCUB environment. Copy to .env:  cp .env.example .env
# Every value here is a LOCAL DEMO placeholder. Never reuse these values outside your machine.

# ── Host ports (change if something else already uses them) ──
WEB_PORT=3000
MOCK_SERVICES_PORT=4000
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380

# ── PostgreSQL ──
POSTGRES_USER=ircub
POSTGRES_PASSWORD=ircub_local_only
POSTGRES_DB=ircub

# Used when running apps directly on the host (pnpm dev, tests).
# docker-compose.yml overrides these with the internal service names.
DATABASE_URL=postgresql://ircub:ircub_local_only@localhost:5433/ircub
TEST_DATABASE_URL=postgresql://ircub:ircub_local_only@localhost:5433/ircub_test
REDIS_URL=redis://localhost:6380

# ── Auth.js ── (generate a real one with: openssl rand -base64 32)
AUTH_SECRET=local-demo-secret-change-me-0123456789abcdef
AUTH_TRUST_HOST=true

# ── Payment channels ──
# Shared HMAC secret used by the mock bank / mobile money to sign callbacks.
CHANNEL_CALLBACK_SECRET=local-demo-callback-secret
MOCK_SERVICES_URL=http://localhost:4000
# Where the mock channels send callbacks (inside Docker this becomes http://web:3000/...).
IRCUB_CALLBACK_URL=http://localhost:3000/api/payments/callback

# ── Mock services behaviour ── (used to demonstrate retries and failures)
MOCK_FAILURE_RATE=0.1
MOCK_DELAY_MS=300

# ── Seed ── password for every seeded demo user (test accounts only)
SEED_DEMO_PASSWORD=Demo@Ircub2026!

LOG_LEVEL=info
