{
  "name": "@ircub/db",
  "version": "1.0.0",
  "private": true,
  "description": "Prisma schema, migrations, raw SQL runner, seed and performance data scripts",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "sql:apply": "tsx scripts/apply-sql.ts",
    "seed": "tsx scripts/seed.ts",
    "migrate:all": "prisma migrate deploy && tsx scripts/apply-sql.ts && tsx scripts/seed.ts",
    "perf-data": "tsx scripts/perf-data.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ircub/core": "workspace:*",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "^18.0.0",
    "pg": "^8.16.0",
    "prisma": "7.10.0",
    "tsx": "^4.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0"
  }
}
